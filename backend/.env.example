# Port HTTP gateway (default 2785, sesuai proxy frontend)
PORT=2785

# API key. Kalau dikosongkan, server akan men-seed satu key default otomatis
# (disimpan ke data/api-key.txt) dan menampilkannya di log saat start.
API_KEY=

# --- AI auto-reply (OpenRouter, OpenAI-compatible) ---
# Wajib: API key dari https://openrouter.ai/keys (isi di backend/.env, BUKAN file ini)
OPENROUTER_API_KEY=
# Opsional: base URL (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model. Default gratis. Alternatif: openai/gpt-4o-mini | qwen/qwen-2.5-72b-instruct
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Aktifkan auto-reply default untuk session baru (1 = ON)
AI_AUTOREPLY=0
# Opsional override: AI_SYSTEM_PROMPT, AI_FALLBACK
