# Port HTTP gateway (default 2785, sesuai proxy frontend)
PORT=2785

# API key. Kalau dikosongkan, server akan men-seed satu key default otomatis
# (disimpan ke data/api-key.txt) dan menampilkannya di log saat start.
API_KEY=

# --- AI auto-reply (OpenRouter, OpenAI-compatible) ---
# Wajib: API key dari https://openrouter.ai/keys (isi di backend/.env, BUKAN file ini)
OPENROUTER_API_KEY=
# Opsional: base URL (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model. Default gratis. Alternatif: openai/gpt-4o-mini | qwen/qwen-2.5-72b-instruct
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Aktifkan auto-reply default untuk session baru (1 = ON)
AI_AUTOREPLY=0
# Opsional override: AI_SYSTEM_PROMPT, AI_FALLBACK

# --- Auth / DB / Email (WAJIB diisi di backend/.env, server menolak boot bila kosong) ---
# Postgres
DATABASE_URL=postgres://openwa:CHANGE_ME@db:5432/openwa
# Secret penandatangan JWT — WAJIB acak kuat. Buat: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Admin = pemilik email ini (otomatis is_admin saat registrasi)
ADMIN_EMAIL=wisnu.yudhanta@gmail.com
# Passphrase untuk membuka area admin (rahasia, jangan sama dgn kredensial lain)
ADMIN_PASSPHRASE=CHANGE_ME

# SMTP untuk OTP verifikasi email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wisnu.yudhanta@gmail.com
SMTP_PASSWORD=CHANGE_ME_gmail_app_password
SMTP_FROM=wisnu.yudhanta@gmail.com
